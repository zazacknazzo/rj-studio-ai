APP_NAME=RJ Studio AI
DATABASE_PATH=data/rj_studio_ai.db
AUTOMATIC_REPLY=Olá! Recebemos sua mensagem e retornaremos em breve. ✨
MESSAGE_RETENTION_DAYS=90

# Copie o Auth Token do Console da Twilio.
TWILIO_AUTH_TOKEN=cole-seu-auth-token-aqui
TWILIO_VALIDATE_SIGNATURE=true

# Use exatamente a URL HTTPS configurada no Sandbox da Twilio.
TWILIO_PUBLIC_WEBHOOK_URL=https://seu-tunel.example/webhooks/twilio
