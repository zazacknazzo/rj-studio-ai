APP_NAME=RJ Studio AI
DATABASE_PATH=data/rj_studio_ai.db
SQLITE_BUSY_TIMEOUT_SECONDS=5
# Deve corresponder ao número de processos configurado no supervisor/uvicorn.
APP_PROCESS_COUNT=1
SALON_KNOWLEDGE_PATH=knowledge/rj_studio.yaml
AUTOMATIC_REPLY=Olá! Recebemos sua mensagem e retornaremos em breve. ✨
MESSAGE_RETENTION_DAYS=90

# Copie o Auth Token do Console da Twilio.
TWILIO_AUTH_TOKEN=cole-seu-auth-token-aqui
TWILIO_VALIDATE_SIGNATURE=true

# Use exatamente a URL HTTPS configurada no Sandbox da Twilio.
TWILIO_PUBLIC_WEBHOOK_URL=https://seu-tunel.example/webhooks/twilio

# Mantenha "legacy" até configurar e validar todo o caminho REST proativo.
DELIVERY_MODE=legacy
TWILIO_STATUS_CALLBACK_URL=https://seu-tunel.example/webhooks/twilio/status
# Use uma API key Twilio dedicada para chamadas REST; o Auth Token acima continua
# necessário para validar assinaturas de webhook.
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_API_KEY_SID=SK00000000000000000000000000000000
TWILIO_API_KEY_SECRET=cole-seu-api-key-secret-aqui
OUTBOUND_REQUEST_TIMEOUT_SECONDS=5
OUTBOUND_POLL_INTERVAL_SECONDS=0.25
OUTBOUND_CONCURRENCY=1
OUTBOUND_MAXIMUM_ATTEMPTS=3
OUTBOUND_RETRY_BACKOFF_BASE_SECONDS=1
OUTBOUND_RETRY_BACKOFF_MAXIMUM_SECONDS=30
PROCESSING_POLL_INTERVAL_SECONDS=0.25
PROCESSING_CONCURRENCY=2

# Runtime LLM. Mantenha "fixed" para desenvolvimento/testes locais sem custos.
LLM_PROVIDER=fixed
# Para habilitar Claude: LLM_PROVIDER=anthropic e preencha todas as variáveis abaixo.
ANTHROPIC_API_KEY=cole-sua-chave-aqui
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_OUTPUT_TOKENS=200
CONVERSATION_CONTEXT_MAXIMUM_MESSAGES=12
CONVERSATION_CONTEXT_MAXIMUM_AGE_DAYS=30
CONVERSATION_CONTEXT_HISTORY_TOKEN_BUDGET=2000
LLM_INPUT_TOKEN_BUDGET=4000
# Consulte a tabela atual da Anthropic. Valores são microdólares por 1 milhão de tokens.
ANTHROPIC_INPUT_MICROUSD_PER_MILLION=
ANTHROPIC_OUTPUT_MICROUSD_PER_MILLION=
