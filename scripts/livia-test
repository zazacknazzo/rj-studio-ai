#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
export DOCKER_HOST="${DOCKER_HOST:-unix://$HOME/.colima/default/docker.sock}"
compose=(docker-compose --env-file .env.b1 -f compose.b1.yaml -f compose.private-test.yaml)
case "${1:-status}" in
  stop) exec scripts/b1 stop ;;
  start)
    "${compose[@]}" up -d --no-build waha backend
    exec .venv/bin/python -m rj_studio_ai.waha_private_cli start ;;
  pause|resume|status) exec .venv/bin/python -m rj_studio_ai.waha_private_cli "${1:-status}" ;;
  *) echo "Uso: scripts/livia-test status|pause|resume|start|stop"; exit 2 ;;
esac
