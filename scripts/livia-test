#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
case "${1:-status}" in
  pause|stop) exec scripts/b1 pause ;;
  resume|start)
    if [[ "${1}" == start ]]; then
      export DOCKER_HOST="${DOCKER_HOST:-unix://$HOME/.colima/default/docker.sock}"
      docker-compose --env-file .env.b1 -f compose.b1.yaml -f compose.private-test.yaml up -d --no-build --no-deps backend
    fi
    scripts/b1 resume
    exec .venv/bin/python -c 'from rj_studio_ai.waha_cli import config,operator_request; import json; print(json.dumps(operator_request(config(), "waha/private-test/start")))'
    ;;
  status)
    exec .venv/bin/python -c 'from rj_studio_ai.waha_cli import config,operator_request; import json; print(json.dumps(operator_request(config(),"ready"),indent=2))'
    ;;
  *) echo "Uso: scripts/livia-test status|pause|resume|start"; exit 2 ;;
esac
